# Скопіюй цей файл як `.env` і впиши свої значення:
#   copy .env.example .env
#
# Файл `.env` у `.gitignore` і ніколи не потрапляє у git.

# Django
# Згенеруй свій: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Хости, яким дозволено звертатися (через кому)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (залишаємо SQLite)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Time & Language
TIME_ZONE=Europe/Kyiv
LANGUAGE_CODE=uk-en
